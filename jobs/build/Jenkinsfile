pipeline {
    agent none
    parameters {
        // branchFilter matches 'origin1' because that's the Jenkins-assigned name for the second SCM
        // remote (helium.git) on this job - depends on remote add-order in the job's UI config, and
        // will silently break (empty BRANCH dropdown) if that remote is ever re-added/reordered.
        gitParameter name: 'BRANCH', type: 'PT_BRANCH', branchFilter: 'origin1/(.*)', defaultValue: 'main',
                     useRepository: 'https://github.com/disrado/helium.git',
                     sortMode: 'ASCENDING_SMART', description: 'helium branch to build'
        booleanParam(name: 'LINUX', defaultValue: true, description: 'Build linux')
        booleanParam(name: 'WINDOWS', defaultValue: true, description: 'Build windows')
    }
    environment {
        IMAGE = 'helium-linux-build-env:latest'
    }
    stages {
        stage('Platforms') {
            parallel {
                stage('linux') {
                    when { expression { params.LINUX } }
                    agent { label 'wsl' }
                    stages {
                        stage('Configure') { steps { script { configure('linux', params.BRANCH) } } }
                        stage('Build')     { steps { script { build('linux') } } }
                        stage('Test')      { steps { script { test('linux') } } }
                    }
                    post { always { script { cleanup() } } }
                }
                stage('windows') {
                    when { expression { params.WINDOWS } }
                    agent { label 'windows' }
                    stages {
                        stage('Configure') { steps { script { configure('windows', params.BRANCH) } } }
                        stage('Build')     { steps { script { build('windows') } } }
                        stage('Test')      { steps { script { test('windows') } } }
                    }
                    post { always { script { cleanup() } } }
                }
            }
        }
    }
}
