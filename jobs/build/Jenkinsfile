@Library('helium_infra') _
pipeline {
    agent none
    parameters {
        separator(name: 'branch_separator', sectionHeader: 'Source')
        gitParameter name: 'Branch', type: 'PT_BRANCH', branchFilter: 'game/(.*)', defaultValue: 'main',
                     useRepository: 'https://github.com/disrado/helium.git',
                     sortMode: 'ASCENDING_SMART', description: 'helium branch to build', listSize: '1'
        separator(name: 'platforms_separator', sectionHeader: 'Target platforms')
        booleanParam(name: 'Linux', defaultValue: true, description: 'Build linux')
        booleanParam(name: 'Windows', defaultValue: true, description: 'Build windows')
        separator(name: 'build_configuration_separator', sectionHeader: 'Build configuration')
        choice(name: 'BuildType', choices: ['debug', 'release'], description: 'Build configuration')
    }
    environment {
        IMAGE = 'helium-linux-build-env:latest'
    }
    stages {
        stage('Platforms') {
            parallel {
                stage('linux') {
                    when { expression { params.Linux } }
                    agent { label 'wsl' }
                    stages {
                        stage('Configure') { steps { script { configure('linux', params.Branch, params.BuildType) } } }
                        stage('Build')     { steps { script { build('linux', params.BuildType, 'game') } } }
                        stage('Test')      { steps { script { test('linux', params.BuildType) } } }
                    }
                    post { always { script { cleanup() } } }
                }
                stage('windows') {
                    when { expression { params.Windows } }
                    agent { label 'windows' }
                    stages {
                        stage('Configure') { steps { script { configure('windows', params.Branch, params.BuildType) } } }
                        stage('Build')     { steps { script { build('windows', params.BuildType, 'game') } } }
                        stage('Test')      { steps { script { test('windows', params.BuildType) } } }
                    }
                    post { always { script { cleanup() } } }
                }
            }
        }
    }
}
