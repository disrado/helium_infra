// update_agent_env job: updates the chosen machine's agent environment (Docker images on WSL, toolchain on
// Windows) - never touches the running container/registration. Targets a specific node by name, not a
// platform label - a label would affect every machine sharing it once there's more than one per platform.
pipeline {
    agent none
    parameters {
        choice(name: 'NODE_NAME', choices: ['wsl_agent', 'windows_agent'], description: 'Which machine to update')
    }
    stages {
        stage('Update') {
            agent { label params.NODE_NAME }
            steps {
                script {
                    if (env.NODE_LABELS.tokenize().contains('wsl')) {
                        sh 'bash build_env/wsl/agent/build_images.sh'
                    } else {
                        bat 'powershell -ExecutionPolicy Bypass -File build_env/windows/devenv/bootstrap_toolchain.ps1 -Root C:/helium_agent'
                    }
                }
            }
            post { always { cleanWs() } }
        }
    }
}
